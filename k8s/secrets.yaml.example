apiVersion: v1
kind: Secret
metadata:
  name: md-to-pdf-secrets
type: Opaque
stringData:
  # Replace these with your ACTUAL values from your .env file
  SMTP_HOST: smtp.email.com
  SMTP_PORT: "###"
  SMTP_USER: your-actual-email@email.com
  SMTP_PASSWORD: your-actual-app-password
  EMAIL_FROM: your-actual-email@email.com